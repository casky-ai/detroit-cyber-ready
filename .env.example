# Detroit Cyber Ready environment
# Copy to .env.local for development. Set the same keys in Vercel project settings.

# --- Required ---

# Supabase. Project URL and keys from the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic. Used by the investigation agent in packages/investigate.
ANTHROPIC_API_KEY=

# Protects POST /api/signals/poll so only the cron can trigger a feed pull.
CRON_SECRET=

# --- Optional, the product degrades gracefully without each of these ---

# Casky platform API. Provides investigation playbooks and CVE analysis.
# Minted through the logged-in Casky web UI; there is no API route that mints one.
# Without it, the caskyApi adapter reports an evidence gap and the investigation
# continues on the remaining sources.
CASKY_API_KEY=
CASKY_API_URL=https://casky.ai

# NVD. Works without a key at a lower rate limit.
NVD_API_KEY=

# Corroborating signal sources. Free tiers.
ABUSECH_API_KEY=
GREYNOISE_API_KEY=

# --- Demo control ---

# DEMO_MODE=1 serves committed snapshots instead of fetching live feeds.
# Always set this for a recorded or live demo. Feeds are never fetched during one.
DEMO_MODE=

# --- Deliberately absent ---
#
# There are no Shodan or Censys keys, and no key for any scanning service.
# This product does not perform reconnaissance against real infrastructure.
# External attack surface data comes from a synthetic source that implements
# the same SurfaceSource interface a real connector would. See docs/connectors.md.
